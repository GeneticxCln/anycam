# Maintainer: AnyCam contributors
pkgname=anycam
pkgver=1.4.0
pkgrel=1
pkgdesc='Linux-native virtual camera studio'
arch=('any')
url='https://github.com/GeneticxCln/anycam'
license=('MIT')
depends=('python' 'python-numpy' 'python-pillow' 'python-psutil' 'python-gobject'
         'pyside6' 'gstreamer' 'gst-plugins-base' 'gst-plugins-good' 'gst-plugins-bad'
         'gst-plugins-ugly' 'gst-libav' 'v4l-utils')
optdepends=('v4l2loopback-dkms: virtual camera device for browsers and meeting apps'
            'python-onnxruntime: AI effects (cut-out, face masks)'
            'python-cryptography: phone camera certificates without openssl'
            'python-segno: QR code for pairing a phone'
            'poppler: PDF slides'
            'yt-dlp: play video-site links'
            'gst-plugin-pipewire: screen capture and the PipeWire camera')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')   # replace with the release tarball's checksum when tagging

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen PYTHONPATH=src python -m pytest -q -x tests/test_model.py
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 anycam.desktop "$pkgdir/usr/share/applications/anycam.desktop"
  # Older release tarballs (v1.3.2) have no packaging/metainfo/; install only
  # when present.
  if [[ -f packaging/metainfo/io.github.geneticxcln.AnyCam.metainfo.xml ]]; then
    install -Dm644 packaging/metainfo/io.github.geneticxcln.AnyCam.metainfo.xml \
      "$pkgdir/usr/share/metainfo/io.github.geneticxcln.AnyCam.metainfo.xml"
  fi
  install -Dm644 src/anycam/assets/anycam-logo.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/anycam.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
