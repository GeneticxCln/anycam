#!/usr/bin/env bash
# Launch the AnyCam GUI. Uses the project venv when present.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
# Run the module rather than the console script: a checkout that was moved
# keeps a stale shebang in .venv/bin/anycam even when .venv/bin/python works.
if [ -x .venv/bin/python ]; then
  exec .venv/bin/python -m anycam gui "$@"
fi
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m anycam gui "$@"
